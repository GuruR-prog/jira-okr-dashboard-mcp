{
  "name": "jira-okr-dashboard-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Jira-over-MCP toolkit: an MCP server for Claude, a one-shot OKR dashboard CLI, and a live multi-workspace team dashboard.",
  "license": "MIT",
  "author": "Guru Raghavendra",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuruR-prog/jira-okr-dashboard-mcp.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup:jira": "node scripts/setup-jira.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "mcp-server": "npm run start --workspace packages/mcp-server",
    "dashboard": "npm run start --workspace packages/dashboard-cli",
    "web-server": "npm run dev --workspace packages/web-server",
    "web-client": "npm run dev --workspace packages/web-client"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
