# ============================================================================
# Single-workspace setup — used by the MCP server (packages/mcp-server) and
# the one-shot dashboard CLI (packages/dashboard-cli). Not used by the web
# dashboard (packages/web-server) — that reads config/workspaces.json instead
# and pulls its tokens from the section further down.
# ============================================================================

# Jira Cloud REST API credentials.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Optional: custom field IDs on your Jira instance. Find them via
# GET /rest/api/3/field, or a field's "View field information" menu — these
# vary per instance/plan, customfield_10016 is just the common Jira Cloud
# default for Story Points.
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_ETA_FIELD=
# Leave blank for Kanban-only boards — issues will just report sprint: null.
JIRA_SPRINT_FIELD=customfield_10020

# Only needed for `npm run dashboard` (the CLI that drives Claude through
# the MCP tools). Not needed to just run the MCP server for Claude Desktop
# or Claude Code, since those bring their own Claude connection.
ANTHROPIC_API_KEY=

# Only needed for `npm run dashboard`.
# A JQL scoped to one OKR, e.g. an epic link or a label you tag OKR work with.
OKR_JQL=labels = "OKR-Q3-2026-reliability"

# ============================================================================
# Multi-workspace setup — used by the web dashboard (packages/web-server).
# Copy config/workspaces.example.json to config/workspaces.json, then set one
# env var per workspace here, matching each entry's "apiTokenEnvVar".
# ANTHROPIC_API_KEY above is reused for the dashboard's "Summarize" button.
# ============================================================================
JIRA_TEAM1_API_TOKEN=
JIRA_TEAM2_API_TOKEN=
JIRA_TEAM3_API_TOKEN=

# ============================================================================
# On-call setup (optional) — used by the web dashboard's on-call roster and
# incident correlation. Copy config/oncall.example.json to config/oncall.json,
# then set the token env var it references here. If you skip this entirely,
# the dashboard runs fine without it — incidents just won't show who was on
# call, and the roster panel reports "not configured".
# Create a token at https://support.pagerduty.com/docs/api-access-keys
# ============================================================================
PAGERDUTY_API_TOKEN=
